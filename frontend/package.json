{
  "name": "@dafne/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dafne/contracts": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "npm": ">=11.20.0",
    "node": ">=26.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "@dafne/backend"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/.next",
          "!{projectRoot}/.next/cache"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "env": "BACKEND_URL"
          },
          {
            "runtime": "node -e \"try{process.stdout.write(require('fs').readFileSync('frontend/.env','utf8'))}catch{}\""
          }
        ]
      }
    }
  }
}
