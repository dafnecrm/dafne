{
  "name": "@dafne/backend-migrator",
  "version": "0.0.1",
  "description": "Applies the migrations of every Dafne database (dafne_auth, dafne_crm, \u2026) in one order, by timestamp; generates them with drizzle-kit",
  "private": true,
  "type": "module",
  "bin": {
    "dafne-migrate": "./src/main.ts"
  },
  "scripts": {
    "migrate": "node src/main.ts",
    "migrate:dev": "node src/main.ts --optional",
    "move-database": "node src/move-database.ts",
    "lint": "oxlint -c ../.oxlintrc.json --type-aware src",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "mysql2": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:backend"
    ],
    "targets": {
      "migrate": {
        "cache": false
      },
      "migrate:dev": {
        "cache": false
      },
      "move-database": {
        "cache": false
      }
    }
  }
}
