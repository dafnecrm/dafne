{
  "name": "@dafne/backend-migrator",
  "version": "0.0.1",
  "description": "Creates the Dafne Postgres database; applies the migrations of every schema (auth, sales, \u2026) in one order, by timestamp; generates them with drizzle-kit",
  "private": true,
  "type": "module",
  "exports": {
    "./start": "./src/start.ts",
    "./bundle": "./src/bundle.ts"
  },
  "bin": {
    "dafne-migrate": "./src/main.ts"
  },
  "scripts": {
    "migrate": "node src/main.ts",
    "migrate:dev": "node src/main.ts --optional",
    "create-database": "node src/create-main.ts",
    "lint": "oxlint -c ../.oxlintrc.json --type-aware src",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:backend"
    ],
    "targets": {
      "migrate": {
        "cache": false
      },
      "migrate:dev": {
        "cache": false
      },
      "create-database": {
        "cache": false
      }
    }
  }
}
