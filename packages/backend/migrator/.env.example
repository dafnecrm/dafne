# The Dafne Postgres database, with the user that owns it and creates its
# schemas (auth, sales, …). Used by `pnpm dafne db migrate`, and by
# `pnpm dafne db create`, which creates this database and user.
MIGRATIONS_DATABASE_URL=postgres://dafne:secret@localhost:5432/dafne

# Only for `pnpm dafne db create`: a superuser of the server.
ADMIN_DATABASE_URL=postgres://postgres:secret@localhost:5432/postgres
