{
  "name": "@dafne/backend-database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "dafne": {
    "schema": "sales"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint -c ../.oxlintrc.json --type-aware src",
    "test": "vitest run --passWithNoTests",
    "migration:generate": "node ../migrator/src/generate.ts"
  },
  "dependencies": {
    "@dafne/backend-database-auth": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@dafne/backend-migrator": "workspace:*",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:backend"
    ]
  }
}
