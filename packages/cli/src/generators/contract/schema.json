{
  "$schema": "https://json-schema.org/schema",
  "$id": "DafneContract",
  "title": "Contract",
  "description": "Request schemas and response types of a resource in packages/contracts.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Resource name, singular or plural (e.g. invoice).",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Resource name (e.g. invoice)"
    },
    "force": { "type": "boolean", "description": "Overwrite files that already exist.", "default": false }
  },
  "required": ["name"]
}
