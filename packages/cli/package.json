{
  "name": "@dafne/cli",
  "version": "0.2.0",
  "description": "Dafne CLI: Nx generators for the backend, and shortcuts for Nx tasks",
  "private": true,
  "type": "module",
  "bin": {
    "dafne": "./src/index.ts"
  },
  "generators": "./generators.json",
  "files": [
    "src",
    "templates",
    "generators.json"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@nx/devkit": "catalog:",
    "commander": "^15.0.0",
    "ejs": "^7.0.2",
    "jsonc-parser": "^3.3.1",
    "nx": "catalog:",
    "pluralize": "^8.0.0",
    "prettier": "catalog:",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.6",
    "@types/pluralize": "^0.0.33",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
