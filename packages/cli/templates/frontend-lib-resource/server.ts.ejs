import { backendFetch } from "@dafne/frontend-api/server";
import type { TableFilters, TableSort } from "@dafne/frontend-data-table";
import { <%= p.constant %>_DEFAULT_SORT } from "./<%= p.kebab %>-table.ts";
import type { <%= s.pascal %>Detail, <%= p.pascal %>List } from "./types.ts";

/*
 * Reads from the backend, for server components (backendFetch forwards the
 * browser's cookies, so it only runs on the server).
 */

/**
 * Calls the backend's GET /<%= p.kebab %>/:id. Throws a BackendError with
 * status 404 when the <%= s.lower %> doesn't exist or was deleted.
 */
export async function get<%= s.pascal %>(id: string): Promise<<%= s.pascal %>Detail> {
  const res = await backendFetch(`/<%= p.kebab %>/${encodeURIComponent(id)}`);
  return res.json();
}

/** Calls the backend's GET /<%= p.kebab %> (deleted <%= p.lower %> are left out). */
export async function list<%= p.pascal %>({
  limit,
  offset,
  filters = {},
  sort = <%= p.constant %>_DEFAULT_SORT,
}: {
  limit: number;
  offset: number;
  filters?: TableFilters;
  sort?: TableSort;
}): Promise<<%= p.pascal %>List> {
  const query = new URLSearchParams({
    limit: String(limit),
    offset: String(offset),
  });
  for (const [field, value] of Object.entries(filters)) {
    query.set(field, value);
  }
  query.set("sortBy", sort.id);
  query.set("sortDirection", sort.desc ? "desc" : "asc");
  const res = await backendFetch(`/<%= p.kebab %>?${query}`);
  return res.json();
}
