"use server";

import { getTranslations } from "next-intl/server";
import { revalidatePath } from "next/cache";
import { redirect } from "next/navigation";
import { BackendError, backendFetch } from "@dafne/frontend-api/server";
import { <%= s.camel %>Schema, type <%= s.pascal %>FormValues } from "./schema.ts";
import type { <%= s.pascal %>Detail } from "./types.ts";

/*
 * <%= s.title %> mutations shared by the apps. The backend checks the session
 * (forwarded by backendFetch) on every call, since these can be invoked by
 * any POST.
 */

export interface ActionError {
  error: string;
}

/** The error to show; the backend's own message is already translated. */
async function errorMessage(error: unknown) {
  if (!(error instanceof BackendError)) {
    throw error;
  }
  const t = await getTranslations();
  if (error.status === 401) {
    return t("common.errors.sessionExpired");
  }
  if (error.status === 404) {
    return t("<%= p.camel %>.notFound");
  }
  return error.message || t("common.errors.generic");
}

/**
 * Creates <%= s.a %> (no `id`) or replaces one, then opens its page
 * (`<path>/<id>`, `path` being the app's <%= p.lower %> list). Returns an
 * error message when it fails.
 */
export async function save<%= s.pascal %>(
  id: <%= s.pascal %>Detail["id"] | null,
  values: <%= s.pascal %>FormValues,
  path: string,
): Promise<ActionError> {
  // Any POST can call this: only redirect within the app.
  if (!/^\/[\w/-]*$/.test(path)) {
    throw new Error(`Invalid path: ${path}`);
  }
  const parsed = <%= s.camel %>Schema.safeParse(values);
  if (!parsed.success) {
    return { error: (await getTranslations())("common.errors.invalid") };
  }

  let savedId: <%= s.pascal %>Detail["id"];
  try {
    const res = await backendFetch(
      id ? `/<%= p.kebab %>/${encodeURIComponent(id)}` : "/<%= p.kebab %>",
      {
        method: id ? "PUT" : "POST",
        body: JSON.stringify(parsed.data),
      },
    );
    savedId = ((await res.json()) as <%= s.pascal %>Detail).id;
  } catch (error) {
    return { error: await errorMessage(error) };
  }
  const href = `${path}/${encodeURIComponent(savedId)}`;
  // The browser keeps visited pages (the edit page among them) in its
  // cache: drop them, or editing again would show the <%= s.lower %> as it was.
  revalidatePath(href, "layout");
  // Outside the try: redirect works by throwing.
  redirect(href);
}

/**
 * Deletes <%= s.a %> (logically: the backend sets deletedAt). The caller
 * refreshes or leaves the page. Returns an error message when it fails.
 */
export async function delete<%= s.pascal %>(
  id: <%= s.pascal %>Detail["id"],
): Promise<ActionError | null> {
  try {
    await backendFetch(`/<%= p.kebab %>/${encodeURIComponent(id)}`, {
      method: "DELETE",
    });
    return null;
  } catch (error) {
    return { error: await errorMessage(error) };
  }
}
