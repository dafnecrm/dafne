import {
  FIELD_COMPONENTS,
  FORM_COMPONENTS,
  fieldContext,
  formContext,
} from "@dafne/frontend-forms/client"
import { createFormHook } from "@tanstack/react-form-nextjs"
import { useLocale } from "next-intl"
import { z } from "zod"
import { en, it } from "zod/locales"

export { setServerError } from "@dafne/frontend-forms/client"

const { useAppForm: useBaseAppForm } = createFormHook({
  fieldContext,
  formContext,
  // The generic fields (@dafne/frontend-forms); add the app's own here.
  fieldComponents: { ...FIELD_COMPONENTS },
  formComponents: FORM_COMPONENTS,
})

const ZOD_LOCALES = { en, it }

/**
 * TanStack's form hook, with Zod's own messages (too long, wrong type…) in
 * the user's language. Contract messages are keys, translated where they're
 * shown (useErrorText, @dafne/frontend-forms).
 */
const useAppForm: typeof useBaseAppForm = (options) => {
  const locale = useLocale() as keyof typeof ZOD_LOCALES
  z.config((ZOD_LOCALES[locale] ?? en)())
  return useBaseAppForm(options)
}

export { useAppForm }
