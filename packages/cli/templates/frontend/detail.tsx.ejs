import {
  CalendarPlusIcon,
  FingerprintIcon,
  HistoryIcon,
  UserPenIcon,
  UserPlusIcon,
} from "lucide-react";
import { useTranslations } from "next-intl";
import CopyButton from "@/components/copy-button";
import { Detail, DetailSection } from "@/components/detail";
import { LocalDate } from "@dafne/frontend-ui/components/local-date";
import type { <%= s.pascal %>Detail } from "@/lib/<%= p.kebab %>";

/** The details of <%= s.a %>: its fields, then who created and updated it. */
export function <%= s.pascal %>Details({ <%= s.camel %> }: { <%= s.camel %>: <%= s.pascal %>Detail }) {
  const t = useTranslations();
  return (
    <>
      <DetailSection title={t("common.record.title")}>
        <Detail icon={FingerprintIcon} label={t("<%= p.camel %>.fields.id")}>
          <div className="flex items-center gap-2">
            <code className="truncate font-mono text-xs">{<%= s.camel %>.id}</code>
            <CopyButton variant="ghost" value={String(<%= s.camel %>.id)} />
          </div>
        </Detail>
        <Detail icon={CalendarPlusIcon} label={t("common.record.created")}>
          <LocalDate value={<%= s.camel %>.createdAt} format="dateTime" />
        </Detail>
        <Detail icon={UserPlusIcon} label={t("common.record.createdBy")}>
          {<%= s.camel %>.createdBy?.name ?? "—"}
        </Detail>
        <Detail icon={HistoryIcon} label={t("common.record.updated")}>
          <LocalDate value={<%= s.camel %>.updatedAt} format="dateTime" />
        </Detail>
        <Detail icon={UserPenIcon} label={t("common.record.updatedBy")}>
          {<%= s.camel %>.updatedBy?.name ?? "—"}
        </Detail>
      </DetailSection>
    </>
  );
}
