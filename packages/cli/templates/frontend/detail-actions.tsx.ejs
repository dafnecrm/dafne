"use client";

import { EllipsisVerticalIcon, <% if (changelog) { %>HistoryIcon, <% } %>PencilIcon, Trash2Icon } from "lucide-react";
import Link from "next/link";
import { useTranslations } from "next-intl";
import { useState } from "react";
import { Button } from "@dafne/frontend-ui/components/button";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from "@dafne/frontend-ui/components/dropdown-menu";
import { Delete<%= s.pascal %>Dialog, type <%= s.pascal %>Ref } from "./<%= s.kebab %>-dialogs";
<% if (changelog) { %>import { <%= s.pascal %>ChangelogSheet } from "./<%= s.kebab %>-changelog";
<% } %>

/** Actions on the <%= s.lower %>'s page, in a menu<% if (changelog) { %> (its history in a sheet)<% } %>. */
export function <%= s.pascal %>DetailActions({ <%= s.camel %> }: { <%= s.camel %>: <%= s.pascal %>Ref }) {
  const [deleting, setDeleting] = useState(false);
<% if (changelog) { %>  const [history, setHistory] = useState(false);
<% } %>  const t = useTranslations();
  const href = `/<%= p.kebab %>/${encodeURIComponent(<%= s.camel %>.id)}`;

  return (
    <>
      <DropdownMenu>
        <DropdownMenuTrigger
          render={
            <Button
              variant="outline"
              size="icon-sm"
              aria-label={t("common.actionsFor", { name: `${t("<%= p.camel %>.singular")} ${<%= s.camel %>.id}` })}
            />
          }
        >
          <EllipsisVerticalIcon />
        </DropdownMenuTrigger>
        <DropdownMenuContent align="end">
          <DropdownMenuItem render={<Link href={`${href}/edit`} />}>
            <PencilIcon />
            {t("common.edit")}
          </DropdownMenuItem>
<% if (changelog) { %>          <DropdownMenuItem onClick={() => setHistory(true)}>
            <HistoryIcon />
            {t("changelog.open")}
          </DropdownMenuItem>
<% } %>          <DropdownMenuSeparator />
          <DropdownMenuItem
            variant="destructive"
            onClick={() => setDeleting(true)}
          >
            <Trash2Icon />
            {t("common.delete")}
          </DropdownMenuItem>
        </DropdownMenuContent>
      </DropdownMenu>
      {/* Outside the menu, which closes when an item is clicked. */}
<% if (changelog) { %>      <<%= s.pascal %>ChangelogSheet
        <%= s.camel %>Id={<%= s.camel %>.id}
        open={history}
        onOpenChange={setHistory}
      />
<% } %>      {deleting && (
        <Delete<%= s.pascal %>Dialog
          <%= s.camel %>={<%= s.camel %>}
          then="list"
          onClose={() => setDeleting(false)}
        />
      )}
    </>
  );
}
