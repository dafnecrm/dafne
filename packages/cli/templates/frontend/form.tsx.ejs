"use client";

import { revalidateLogic } from "@tanstack/react-form-nextjs";
import Link from "next/link";
import { useTranslations } from "next-intl";
import { Button } from "@dafne/frontend-ui/components/button";
import { Card, CardContent, CardHeader, CardTitle } from "@dafne/frontend-ui/components/card";
import { FieldGroup } from "@dafne/frontend-ui/components/field";
import { setServerError, useAppForm } from "@/lib/app-form/app-form";
import { useResetOnLeave } from "@dafne/frontend-forms/client";
import type { <%= s.pascal %>Detail } from "@/lib/<%= p.kebab %>";
import { save<%= s.pascal %> } from "./actions";
import { <%= s.camel %>FormOpts, <%= s.camel %>Schema } from "./schema";

/** Creates <%= s.a %>, or edits `<%= s.camel %>`. Saving opens its page. */
export function <%= s.pascal %>Form({ <%= s.camel %> }: { <%= s.camel %>?: <%= s.pascal %>Detail }) {
  const t = useTranslations();
  const form = useAppForm({
    ...<%= s.camel %>FormOpts(<%= s.camel %>),
    // Validate on submit, then on every change.
    validationLogic: revalidateLogic(),
    validators: { onDynamic: <%= s.camel %>Schema },
    onSubmit: async ({ value, formApi }) => {
      // Redirects on success, so only an error comes back.
      const result = await save<%= s.pascal %>(<%= s.camel %>?.id ?? null, value);
      if (result?.error) setServerError(formApi, result.error);
    },
  });
  // The page stays mounted (hidden) after leaving it: start fresh next time.
  useResetOnLeave(form);
  const cancelHref = <%= s.camel %>
    ? `/<%= p.kebab %>/${encodeURIComponent(<%= s.camel %>.id)}`
    : "/<%= p.kebab %>";

  return (
    <form
      noValidate
      onSubmit={(e) => {
        e.preventDefault();
        form.handleSubmit();
      }}
    >
      <form.AppForm>
        <FieldGroup>
          <form.FormErrors />
          <Card>
            <CardHeader>
              <CardTitle>
                <h2>{t("<%= p.camel %>.sections.details")}</h2>
              </CardTitle>
            </CardHeader>
            <CardContent>
              {/* The fields: dafne g/sync add one <form.AppField> per field of the contract's body. */}
              <div className="grid grid-cols-1 gap-4 md:grid-cols-3"></div>
            </CardContent>
          </Card>

          <div className="flex justify-end gap-2">
            <Button
              variant="outline"
              nativeButton={false}
              render={<Link href={cancelHref} />}
            >
              {t("common.cancel")}
            </Button>
            <form.SubmitButton
              label={t(<%= s.camel %> ? "common.saveChanges" : "<%= p.camel %>.create")}
            />
          </div>
        </FieldGroup>
      </form.AppForm>
    </form>
  );
}
