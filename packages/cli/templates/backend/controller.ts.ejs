import {
  Body,
  Controller,
  Delete,
  Get,
  HttpCode,
  HttpStatus,
  Param,
  Post,
  Put,
  Query,
} from '@nestjs/common';
import { Session } from '@dafne/backend-session';
import type { UserSession } from '@dafne/backend-session';
import { <%= id.pipeImport %>, ZodValidationPipe } from '@dafne/backend-common';
import {
  <%= s.camel %>BodySchema,
  list<%= p.pascal %>QuerySchema,
  type <%= s.pascal %>Body,
  type <%= s.pascal %>Detail,
  type <%= p.pascal %>List,
  type List<%= p.pascal %>Query,
} from '@dafne/contracts';
import type { CrudController } from '@dafne/backend-crud';
import { <%= p.pascal %>Service } from './<%= p.kebab %>.service.js';

/** <%= p.title %>, for any signed-in user (the global auth guard checks it). */
@Controller('<%= p.kebab %>')
export class <%= p.pascal %>Controller
  implements
    CrudController<
      <%= id.ts %>,
      List<%= p.pascal %>Query,
      <%= p.pascal %>List,
      <%= s.pascal %>Body,
      <%= s.pascal %>Detail
    >
{
  constructor(private readonly <%= p.camel %>Service: <%= p.pascal %>Service) {}

  @Get()
  list(
    @Query(new ZodValidationPipe(list<%= p.pascal %>QuerySchema))
    query: List<%= p.pascal %>Query,
  ): Promise<<%= p.pascal %>List> {
    return this.<%= p.camel %>Service.list(query);
  }

  @Get(':id')
  get(@Param('id', <%= id.pipe %>) id: <%= id.ts %>): Promise<<%= s.pascal %>Detail> {
    return this.<%= p.camel %>Service.get(id);
  }

  @Post()
  create(
    @Body(new ZodValidationPipe(<%= s.camel %>BodySchema)) body: <%= s.pascal %>Body,
    @Session() session: UserSession,
  ): Promise<<%= s.pascal %>Detail> {
    return this.<%= p.camel %>Service.create(body, session.user);
  }

  @Put(':id')
  update(
    @Param('id', <%= id.pipe %>) id: <%= id.ts %>,
    @Body(new ZodValidationPipe(<%= s.camel %>BodySchema)) body: <%= s.pascal %>Body,
    @Session() session: UserSession,
  ): Promise<<%= s.pascal %>Detail> {
    return this.<%= p.camel %>Service.update(id, body, session.user);
  }

  /** Logical delete. */
  @Delete(':id')
  @HttpCode(HttpStatus.NO_CONTENT)
  async delete(
    @Param('id', <%= id.pipe %>) id: <%= id.ts %>,
    @Session() session: UserSession,
  ): Promise<void> {
    await this.<%= p.camel %>Service.delete(id, session.user);
  }
}
