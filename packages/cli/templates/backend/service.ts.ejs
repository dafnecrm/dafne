import { schema, type Database } from '@dafne/backend-database';
import { InjectDrizzle } from '@nestjs/drizzle';
<% if (id.clientPicks) { %>import { PostgresErrorCode, rethrowPostgresError } from '@dafne/backend-common';
import { ConflictException, Injectable, NotFoundException } from '@nestjs/common';
<% } else { %>import { Injectable, NotFoundException } from '@nestjs/common';
<% } %>
import { and, asc, desc, eq, isNull, ilike, type Column, type SQL } from 'drizzle-orm';
import {
  <%= s.constant %>_FILTER_FIELDS,
  type <%= s.pascal %>FilterField,
  type <%= s.pascal %>Body,
  type <%= s.pascal %>Detail,
  type <%= p.pascal %>List,
  type List<%= p.pascal %>Query,
  msg,
} from '@dafne/contracts';
import {
  CrudHooksRegistry,
  type Actor,
  type CrudHooks,
  type CrudService,
  type Executor,
} from '@dafne/backend-crud';

export const <%= p.constant %>_DEFAULT_PAGE_SIZE = 20;

const { <%= s.camel %> } = schema;

/** Escapes LIKE wildcards so the value is matched literally. */
const escapeLike = (value: string) => value.replace(/[\\%_]/g, '\\$&');

/**
 * Filters matched exactly (the id and the keys to other records), with how
 * their query param becomes the column's value; the others contain the text.
 */
const EXACT_FILTERS: Partial<Record<<%= s.pascal %>FilterField, (value: string) => number | string>> = {
  id: <%= id.filterParse %>,
};

/** <%= p.title %> that haven't been deleted. */
const notDeleted = isNull(<%= s.camel %>.deletedAt);

<% if (id.clientPicks) { %>/** A taken id (the client picks it) becomes a 409. */
const rethrowTakenId = rethrowPostgresError([
  {
    code: PostgresErrorCode.UNIQUE_VIOLATION,
    constraint: '<%= s.snake %>_pkey',
    error: () => new ConflictException(msg('<%= p.camel %>.id.taken')),
  },
]);

<% } %>/** Only the user's ID and name, for "created by" / "updated by". */
const userSummary = { columns: { id: true, name: true } } as const;

@Injectable()
export class <%= p.pascal %>Service
  implements
    CrudService<
      <%= id.ts %>,
      List<%= p.pascal %>Query,
      <%= p.pascal %>List,
      <%= s.pascal %>Body,
      <%= s.pascal %>Detail
    >
{
  /** Runs the writes with the hooks registered on `<%= p.kebab %>`. */
  private readonly hooks: CrudHooks<<%= id.ts %>, <%= s.pascal %>Body, <%= s.pascal %>Detail>;

  constructor(
    @InjectDrizzle() private readonly db: Database,
    registry: CrudHooksRegistry,
  ) {
    this.hooks = registry.for('<%= p.kebab %>', { db, load: (id, tx) => this.get(id, tx) });
  }

  /**
   * Lists <%= p.lower %> that aren't deleted, paged and sorted, filtered by
   * every field given (AND, each matching text the field contains).
   */
  async list(query: List<%= p.pascal %>Query = {}): Promise<<%= p.pascal %>List> {
    const {
      limit = <%= p.constant %>_DEFAULT_PAGE_SIZE,
      offset = 0,
      sortBy = 'id',
      sortDirection = 'desc',
    } = query;
    const { db } = this;
    const filters = <%= s.constant %>_FILTER_FIELDS.flatMap((field) => {
      const value = query[field]?.trim();
      if (!value) {
        return [];
      }
      const exact = EXACT_FILTERS[field];
      // As a plain Column: eq can't type a union of columns against number | string.
      return [exact ? eq(<%= s.camel %>[field] as Column, exact(value)) : ilike(<%= s.camel %>[field], `%${escapeLike(value)}%`)];
    });
    const where = and(notDeleted, ...filters) as SQL;
    const direction = sortDirection === 'asc' ? asc : desc;

    const [<%= p.camel %>, total] = await Promise.all([
      db
        .select({
          id: <%= s.camel %>.id,
          createdAt: <%= s.camel %>.createdAt,
          updatedAt: <%= s.camel %>.updatedAt,
        })
        .from(<%= s.camel %>)
        .where(where)
        .orderBy(direction(<%= s.camel %>[sortBy]), asc(<%= s.camel %>.id))
        .limit(limit)
        .offset(offset),
      db.$count(<%= s.camel %>, where),
    ]);

    return { <%= p.camel %>, total, limit, offset };
  }

  /**
   * One <%= s.lower %> that isn't deleted, with who created and last
   * updated it. Throws 404 otherwise.
   */
  async get(id: <%= id.ts %>, db: Executor = this.db): Promise<<%= s.pascal %>Detail> {
    const found = await db.query.<%= s.camel %>.findFirst({
      where: { id, deletedAt: { isNull: true } },
      columns: { createdById: false, updatedById: false },
      with: { createdBy: userSummary, updatedBy: userSummary },
    });
    if (!found) {
      throw new NotFoundException(msg('<%= p.camel %>.notFound'));
    }
    return found;
  }

  /**
   * Creates <%= s.a %>; `actor` is the creator. Runs the hooks registered on
   * `<%= p.kebab %>` (CrudHooksModule.forFeature), in one transaction.
   */
  async create(body: <%= s.pascal %>Body, actor: Actor): Promise<<%= s.pascal %>Detail> {
    // One instant for both: createdAt and updatedAt start equal.
    const now = new Date();
    return this.hooks.create({ body, actor }, async ({ tx, body }) => {
      // <%= id.createComment %>
      const [{ id }] = await tx
        .insert(<%= s.camel %>)
        .values({
          createdAt: now,
          updatedAt: now,
          createdById: actor.id,
          updatedById: actor.id,
        })
        .returning({ id: <%= s.camel %>.id })<% if (id.clientPicks) { %>
        .catch(rethrowTakenId)<% } %>;
      return id;
    });
  }

  /**
   * Replaces <%= s.a %>'s fields; `actor` is the editor. Throws 404
   * if the <%= s.lower %> doesn't exist or is deleted.
   */
  async update(
    id: <%= id.ts %>,
    body: <%= s.pascal %>Body,
    actor: Actor,
  ): Promise<<%= s.pascal %>Detail> {
    return this.hooks.update({ id, body, actor }, async ({ tx, body }) => {
      const result = await tx
        .update(<%= s.camel %>)
        .set({
          updatedById: actor.id,
          // The time of this change.
          updatedAt: new Date(),
        })
        .where(and(eq(<%= s.camel %>.id, id), notDeleted));
      if (result.rowCount === 0) {
        throw new NotFoundException(msg('<%= p.camel %>.notFound'));
      }
    });
  }

  /**
   * Deletes <%= s.a %> logically: sets deletedAt, so it disappears
   * from the API but stays in the database. Throws 404 if already deleted.
   */
  async delete(id: <%= id.ts %>, actor: Actor): Promise<void> {
    await this.hooks.delete({ id, actor }, async ({ tx }) => {
      const now = new Date();
      const result = await tx
        .update(<%= s.camel %>)
        .set({ deletedAt: now, updatedAt: now, updatedById: actor.id })
        .where(and(eq(<%= s.camel %>.id, id), notDeleted));
      if (result.rowCount === 0) {
        throw new NotFoundException(msg('<%= p.camel %>.notFound'));
      }
    });
  }
}
