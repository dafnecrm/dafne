<% for (const line of id.tableImports) { %><%= line %>
<% } %>import { defineRelationsPart } from 'drizzle-orm';
import { index, timestamp, varchar<%= id.builder === 'varchar' ? '' : ', ' + id.builder %> } from 'drizzle-orm/pg-core';
import { user } from '../auth.js';
import { salesSchema } from './sales.js';

/**
 * <%= s.A %> managed by the users. Deletion is logical: `deletedAt` is
 * set and the row is hidden from every query, but kept in the table.
 */
export const <%= s.camel %> = salesSchema.table(
  '<%= s.snake %>',
  {
    id: <%= id.column %>,
    createdAt: timestamp('created_at', { precision: 3, withTimezone: true })
      .defaultNow()
      .notNull(),
    updatedAt: timestamp('updated_at', { precision: 3, withTimezone: true })
      .defaultNow()
      .$onUpdate(() => new Date())
      .notNull(),
    deletedAt: timestamp('deleted_at', { precision: 3, withTimezone: true }),
    // Nullable so removing a user keeps the <%= p.lower %> they touched.
    createdById: varchar('created_by_id', { length: 36 }).references(
      () => user.id,
      { onDelete: 'set null' },
    ),
    updatedById: varchar('updated_by_id', { length: 36 }).references(
      () => user.id,
      { onDelete: 'set null' },
    ),
  },
  (table) => [
    index('<%= s.snake %>_deletedAt_idx').on(table.deletedAt),
  ],
);

export const <%= s.camel %>Relations = defineRelationsPart(
  { user, <%= s.camel %> },
  (r) => ({
    <%= s.camel %>: {
      createdBy: r.one.user({
        from: r.<%= s.camel %>.createdById,
        to: r.user.id,
        alias: '<%= s.camel %>CreatedBy',
      }),
      updatedBy: r.one.user({
        from: r.<%= s.camel %>.updatedById,
        to: r.user.id,
        alias: '<%= s.camel %>UpdatedBy',
      }),
    },
  }),
);
