{
  "name": "@dafne/cli-old",
  "version": "0.1.0",
  "description": "Previous Dafne generator (backend and frontend resources), kept for what the new CLI does not cover",
  "private": true,
  "type": "module",
  "bin": {
    "dafne-old": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "npm": ">=11.20.0",
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "ejs": "^7.0.2",
    "jsonc-parser": "^3.3.1",
    "pluralize": "^8.0.0",
    "prettier": "catalog:",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.6",
    "@types/pluralize": "^0.0.33",
    "tsup": "^9.0.0",
    "tsx": "catalog:",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
