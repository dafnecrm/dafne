import type { Metadata } from "next";
import { getTranslations } from "next-intl/server";
import { Suspense } from "react";
import { BreadcrumbLabel } from "@/components/page-breadcrumb";
import {
  PageContent,
  PageContentBody,
  PageContentDescription,
  PageContentHeader,
  PageContentTitle,
} from "@/components/page-content";
import { Skeleton } from "@/components/ui/skeleton";
import { <%= s.pascal %>Form } from "../../<%= s.kebab %>-form";
import { load<%= s.pascal %> } from "../load-<%= s.kebab %>";

export async function generateMetadata(): Promise<Metadata> {
  const t = await getTranslations();
  return { title: t("<%= p.camel %>.editMeta") };
}

export default function Edit<%= s.pascal %>Page({
  params,
}: PageProps<"/[locale]/<%= p.kebab %>/[id]/edit">) {
  return (
    <Suspense fallback={<Skeleton className="h-96 w-full" />}>
      <Edit<%= s.pascal %> params={params} />
    </Suspense>
  );
}

async function Edit<%= s.pascal %>({
  params,
}: Pick<PageProps<"/[locale]/<%= p.kebab %>/[id]/edit">, "params">) {
  const <%= s.camel %> = await load<%= s.pascal %>((await params).id);
  const t = await getTranslations();

  return (
    <PageContent>
      <BreadcrumbLabel
        href={`/<%= p.kebab %>/${encodeURIComponent(<%= s.camel %>.id)}`}
        label={<%= s.camel %>.name}
      />
      <PageContentHeader>
        <PageContentTitle>
          {t("common.editTitle", { name: <%= s.camel %>.name })}
        </PageContentTitle>
        <PageContentDescription>
          {t("<%= p.camel %>.editDescription")}
        </PageContentDescription>
      </PageContentHeader>
      <PageContentBody>
        <<%= s.pascal %>Form <%= s.camel %>={<%= s.camel %>} />
      </PageContentBody>
    </PageContent>
  );
}
