import { <%= s.camel %>BodySchema, list<%= p.pascal %>QuerySchema } from './<%= p.kebab %>.ts';

/** Paths of the fields that failed, e.g. ['name']. */
function failedFields(body: unknown) {
  const result = <%= s.camel %>BodySchema.safeParse(body);
  return result.success
    ? []
    : result.error.issues.map((issue) => issue.path.join('.') || issue.code);
}

describe('<%= s.camel %>BodySchema', () => {
  it('trims values', () => {
    expect(<%= s.camel %>BodySchema.parse({ name: '  Acme  ' })).toEqual({
      name: 'Acme',
    });
  });

  it('rejects a blank name', () => {
    expect(failedFields({ name: '   ' })).toEqual(['name']);
  });

  it('rejects unknown properties such as deletedAt', () => {
    expect(failedFields({ name: 'Acme', deletedAt: '2026-01-01' })).toEqual([
      'unrecognized_keys',
    ]);
  });
});

describe('list<%= p.pascal %>QuerySchema', () => {
  it('turns limit and offset into numbers', () => {
    expect(
      list<%= p.pascal %>QuerySchema.parse({ limit: '10', offset: '20' }),
    ).toEqual({ limit: 10, offset: 20 });
  });

  it('rejects an unknown sort field and a limit over 100', () => {
    const result = list<%= p.pascal %>QuerySchema.safeParse({
      sortBy: 'password',
      limit: '500',
    });
    expect(result.success).toBe(false);
  });
});
