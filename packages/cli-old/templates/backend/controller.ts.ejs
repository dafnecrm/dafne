import {
  Body,
  Controller,
  Delete,
  Get,
  HttpCode,
  HttpStatus,
  Param,
  Post,
  Put,
  Query,
} from '@nestjs/common';
import { Session } from '@dafne/backend-session';
import type { UserSession } from '@dafne/backend-session';
import { ZodValidationPipe } from '@dafne/backend-common';
import {
  <%= s.camel %>BodySchema,
  list<%= p.pascal %>QuerySchema,
  type <%= s.pascal %>Body,
  type <%= s.pascal %>Detail,
  type <%= p.pascal %>List,
  type List<%= p.pascal %>Query,
} from '@dafne/contracts';
import { <%= p.pascal %>Service } from './<%= p.kebab %>.service.js';

/** <%= p.title %>, for any signed-in user (the global auth guard checks it). */
@Controller('<%= p.kebab %>')
export class <%= p.pascal %>Controller {
  constructor(private readonly <%= p.camel %>Service: <%= p.pascal %>Service) {}

  @Get()
  list<%= p.pascal %>(
    @Query(new ZodValidationPipe(list<%= p.pascal %>QuerySchema))
    query: List<%= p.pascal %>Query,
  ): Promise<<%= p.pascal %>List> {
    return this.<%= p.camel %>Service.list<%= p.pascal %>(query);
  }

  @Get(':id')
  get<%= s.pascal %>(@Param('id') id: string): Promise<<%= s.pascal %>Detail> {
    return this.<%= p.camel %>Service.get<%= s.pascal %>(id);
  }

  @Post()
  create<%= s.pascal %>(
    @Body(new ZodValidationPipe(<%= s.camel %>BodySchema)) body: <%= s.pascal %>Body,
    @Session() session: UserSession,
  ): Promise<<%= s.pascal %>Detail> {
    return this.<%= p.camel %>Service.create<%= s.pascal %>(body, session.user.id);
  }

  @Put(':id')
  update<%= s.pascal %>(
    @Param('id') id: string,
    @Body(new ZodValidationPipe(<%= s.camel %>BodySchema)) body: <%= s.pascal %>Body,
    @Session() session: UserSession,
  ): Promise<<%= s.pascal %>Detail> {
    return this.<%= p.camel %>Service.update<%= s.pascal %>(id, body, session.user.id);
  }

  /** Logical delete. */
  @Delete(':id')
  @HttpCode(HttpStatus.NO_CONTENT)
  async delete<%= s.pascal %>(
    @Param('id') id: string,
    @Session() session: UserSession,
  ): Promise<void> {
    await this.<%= p.camel %>Service.delete<%= s.pascal %>(id, session.user.id);
  }
}
