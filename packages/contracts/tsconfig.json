{
  // Source-only package: the backend and the frontend compile it themselves.
  // Relative imports end in .ts (see src/index.ts).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc",
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
