{
  "name": "dafne",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "affected": "nx affected -t lint typecheck test build",
    "graph": "nx graph",
    "dafne": "node packages/cli/src/index.ts",
    "dafne-old": "pnpm --filter @dafne/cli-old dev",
    "boundaries": "node tools/check-boundaries.mjs"
  },
  "devDependencies": {
    "@dafne/cli": "workspace:*",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "24.0.4",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "nx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
