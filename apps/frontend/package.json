{
  "name": "@dafne/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dafne/contracts": "workspace:*",
    "@dafne/frontend-api": "workspace:*",
    "@dafne/frontend-auth": "workspace:*",
    "@dafne/frontend-data-table": "workspace:*",
    "@dafne/frontend-forms": "workspace:*",
    "@dafne/frontend-ui": "workspace:*",
    "@tanstack/react-form-nextjs": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "npm": ">=11.20.0",
    "node": ">=26.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/.next",
          "!{projectRoot}/.next/cache"
        ],
        "inputs": [
          "production",
          "^production",
          {
            "env": "BACKEND_URL"
          },
          {
            "runtime": "node -e \"try{process.stdout.write(require('fs').readFileSync('apps/frontend/.env','utf8'))}catch{}\""
          }
        ]
      }
    }
  }
}
