# apps/crm-api: the CRM's API.
PORT=3000

# dafne_crm, with the CRM's own MySQL user (plus SELECT, REFERENCES on dafne_auth.user).
DATABASE_URL=mysql://dafne_crm:secret@localhost:3306/dafne_crm

# apps/auth: the API asks it for the session of each request's cookie.
AUTH_URL=http://localhost:3001

## Cache (CacheModule in CrmApiModule); without it the cache is in memory.
REDIS_URL=redis://localhost:6379
