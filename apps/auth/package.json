{
  "name": "@dafne/auth",
  "version": "0.0.1",
  "private": true,
  "dafne": {
    "dev": { "host": "auth", "port": 3001 }
  },
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec \"node --import ./dist/telemetry.js\"",
    "dev": "nest start --watch --exec \"node --import ./dist/telemetry.js\"",
    "start:debug": "nest start --debug --watch --exec \"node --import ./dist/telemetry.js\"",
    "start:prod": "node --import ./dist/telemetry.js dist/main",
    "lint": "oxlint --type-aware src",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@dafne/auth-options": "workspace:*",
    "@dafne/backend-auth": "workspace:*",
    "@dafne/backend-changelog": "workspace:*",
    "@dafne/backend-common": "workspace:*",
    "@dafne/backend-database-auth": "workspace:*",
    "@dafne/backend-logger": "workspace:*",
    "@dafne/backend-migrator": "workspace:*",
    "@dafne/backend-telemetry": "workspace:*",
    "@dafne/backend-user-groups": "workspace:*",
    "@dafne/backend-users": "workspace:*",
    "@dafne/contracts": "workspace:*",
    "@keyv/redis": "^6.1.0",
    "@nestjs/cache-manager": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/instrumentation-express": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@thallesp/nestjs-better-auth": "catalog:",
    "better-auth": "catalog:",
    "cache-manager": "^7.2.9",
    "drizzle-orm": "catalog:",
    "import-in-the-middle": "catalog:",
    "keyv": "^6.1.0",
    "nestjs-pino": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "pino-roll": "catalog:",
    "reflect-metadata": "^0.2.2",
    "resend": "catalog:",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "catalog:",
    "@rspack/core": "^2.2.9",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "webpack-node-externals": "^3.0.0"
  },
  "nx": {
    "tags": [
      "scope:backend"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ],
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/packages/backend/*/migrations/*/migration.sql"
        ]
      },
      "dev": {
        "dependsOn": [
          {
            "projects": [
              "@dafne/backend-migrator"
            ],
            "target": "migrate:dev"
          }
        ]
      }
    }
  }
}
