{
  "name": "@dafne/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@dafne/auth-options": "workspace:*",
    "@dafne/backend-auth": "workspace:*",
    "@dafne/backend-common": "workspace:*",
    "@dafne/backend-database-auth": "workspace:*",
    "@dafne/backend-migrator": "workspace:*",
    "@dafne/backend-users": "workspace:*",
    "@dafne/contracts": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/drizzle": "catalog:",
    "@nestjs/platform-express": "^12.0.1",
    "@thallesp/nestjs-better-auth": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "^0.2.2",
    "resend": "catalog:",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "catalog:",
    "@rspack/core": "^2.2.9",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:",
    "webpack-node-externals": "^3.0.0"
  },
  "nx": {
    "tags": [
      "scope:backend"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ],
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/packages/backend/*/migrations/*/migration.sql"
        ]
      },
      "dev": {
        "dependsOn": [
          {
            "projects": [
              "@dafne/backend-migrator"
            ],
            "target": "migrate:dev"
          }
        ]
      }
    }
  }
}
