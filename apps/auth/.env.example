# apps/auth: sign-in (Better Auth), users and app access, for every Dafne app.
PORT=3001

# The Dafne database. In development, its owner (the role `pnpm dafne db
# create` makes, as in MIGRATIONS_DATABASE_URL). In production, the app's
# own role, e.g. dafne_auth (grants in docs/databases.md, "Roles and grants").
DATABASE_URL=postgres://dafne:secret@db.dafne.localhost:5432/dafne

## Migrations on startup (production)
# true: before starting, apply the pending migrations of every schema
# (bundled in dist/migrations), as `pnpm dafne db migrate` does. Off in development:
# `dafne dev` migrates first.
MIGRATE_ON_START=false
# Needed with MIGRATE_ON_START=true: a user that can create and alter the schemas.
MIGRATIONS_DATABASE_URL=

## Cache shared with the apps (CacheModule in AuthModule): the same Redis
# as theirs, so a change to a user group applies at once. Without it the
# cache is in memory, and the apps see the change within a minute.
REDIS_URL=redis://redis.dafne.localhost:6379

## Better Auth
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# The frontends' hosts (comma-separated, wildcards allowed). Each one
# proxies /api/auth here, and its email links go back to it. They are
# trusted origins too. `dafne dev` adds the hosts it serves (with the
# port when it isn't the default one). Empty: BETTER_AUTH_URL for every app.
AUTH_ALLOWED_HOSTS=*.dafne.localhost,localhost:4000
# Public URL in email links when the request gives no allowed host (or
# every link, without AUTH_ALLOWED_HOSTS): a frontend. https:// makes the
# session cookie secure (__Secure-dafne.session_token); Chrome and Firefox
# accept it on http://*.localhost too (with `dafne dev --no-https`).
BETTER_AUTH_URL=https://sales-web.dafne.localhost
# Other origins allowed to call it (comma-separated), besides the allowed hosts.
TRUSTED_ORIGINS=
# Parent domain of the apps, so they share the session cookie
# (e.g. cliente.it for sales.cliente.it and reporting.cliente.it, or
# dafne.localhost in development: then sign-in works on *.dafne.localhost,
# not on localhost:4000). Empty: this host only.
COOKIE_DOMAIN=dafne.localhost
# Apps a new user can use from the start (app_access), comma-separated.
DEFAULT_APPS=sales
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Users made super-admin on startup, if they exist (comma-separated): only a
# super-admin can grant the role from the UI, so the first one comes from here.
SUPER_ADMIN_EMAILS=

## Resend (verification emails)
RESEND_API_KEY=re_xxx
