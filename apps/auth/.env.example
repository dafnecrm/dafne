# apps/auth: sign-in (Better Auth), users and app access, for every Dafne app.
PORT=3001

# dafne_auth, with the auth app's own MySQL user.
DATABASE_URL=mysql://dafne_auth:secret@localhost:3306/dafne_auth

## Migrations on startup (production)
# true: before starting, apply the pending migrations of every dafne_* database
# (bundled in dist/migrations), as `pnpm dafne db migrate` does. Off in development:
# `dafne dev` migrates first.
MIGRATE_ON_START=false
# Needed with MIGRATE_ON_START=true: a user that can create and alter the dafne_* databases.
MIGRATIONS_DATABASE_URL=

## Better Auth
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# Public URL used in email links: the frontend (it proxies /api/auth here).
BETTER_AUTH_URL=http://localhost:4000
# The frontends allowed to call it (comma-separated).
TRUSTED_ORIGINS=http://localhost:4000
# Parent domain of the apps, so they share the session cookie
# (e.g. cliente.it for sales.cliente.it and reporting.cliente.it). Empty: this host only.
COOKIE_DOMAIN=
# Apps a new user can use from the start (app_access), comma-separated.
DEFAULT_APPS=sales
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

## Resend (verification emails)
RESEND_API_KEY=re_xxx
