# apps/sales-api: the CRM's API.
PORT=3000

# dafne_sales, with the CRM's own MySQL user (plus SELECT, REFERENCES on dafne_auth.user).
DATABASE_URL=mysql://dafne_sales:secret@localhost:3306/dafne_sales

# apps/auth: the API asks it for the session of each request's cookie.
AUTH_URL=http://localhost:3001

## Migrations on startup (production)
# true: before starting, apply the pending migrations of every dafne_* database
# (bundled in dist/migrations), as `pnpm dafne db migrate` does. Off in development:
# `dafne dev` migrates first.
MIGRATE_ON_START=false
# Needed with MIGRATE_ON_START=true: a user that can create and alter the dafne_* databases.
MIGRATIONS_DATABASE_URL=

## Cache (CacheModule in SalesApiModule); without it the cache is in memory.
REDIS_URL=redis://localhost:6379
