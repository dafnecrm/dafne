# apps/sales-api: the CRM's API.
PORT=3000

# The Dafne database. In development, its owner (the role `pnpm dafne db
# create` makes, as in MIGRATIONS_DATABASE_URL). In production, the app's
# own role, e.g. dafne_sales (grants in docs/databases.md, "Roles and grants").
DATABASE_URL=postgres://dafne:secret@db.dafne.localhost:5432/dafne

# apps/auth: the API asks it for the session of each request's cookie.
AUTH_URL=http://localhost:3001

## Migrations on startup (production)
# true: before starting, apply the pending migrations of every schema
# (bundled in dist/migrations), as `pnpm dafne db migrate` does. Off in development:
# `dafne dev` migrates first.
MIGRATE_ON_START=false
# Needed with MIGRATE_ON_START=true: a user that can create and alter the schemas.
MIGRATIONS_DATABASE_URL=

## Cache (CacheModule in SalesApiModule); without it the cache is in memory.
REDIS_URL=redis://redis.dafne.localhost:6379

## Documents (@dafne/backend-documents)
# Gotenberg, which converts the documents filled from the uploaded Word
# templates to PDF (the gotenberg service of compose.yaml in development).
GOTENBERG_URL=http://gotenberg.dafne.localhost:3100

## AI assistant (@dafne/backend-assistant)
# API keys of the providers, named by each provider's "API key variable"
# (its apiKeyEnv): keys are never stored in the database. None is needed
# for a local Ollama.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Messages a user may send every 10 minutes (default 30).
ASSISTANT_RATE_LIMIT=30
