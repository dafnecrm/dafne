# apps/sales-api: the CRM's API.
PORT=3000

# The Dafne database, with the sales app's own role (rights on the sales schema,
# plus USAGE on auth and SELECT, REFERENCES on auth.user).
DATABASE_URL=postgres://dafne_sales:secret@localhost:5432/dafne

# apps/auth: the API asks it for the session of each request's cookie.
AUTH_URL=http://localhost:3001

## Migrations on startup (production)
# true: before starting, apply the pending migrations of every schema
# (bundled in dist/migrations), as `pnpm dafne db migrate` does. Off in development:
# `dafne dev` migrates first.
MIGRATE_ON_START=false
# Needed with MIGRATE_ON_START=true: a user that can create and alter the schemas.
MIGRATIONS_DATABASE_URL=

## Cache (CacheModule in SalesApiModule); without it the cache is in memory.
REDIS_URL=redis://localhost:6379
