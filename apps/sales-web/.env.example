# apps/sales-web: the CRM's frontend.
# The CRM's API (server-side calls: backendFetch).
BACKEND_URL=http://localhost:3000
# apps/auth: /api/auth is proxied there (next.config.ts), sessions and users.
AUTH_URL=http://localhost:3001
# This app's public URL (Origin of the server-side calls, in TRUSTED_ORIGINS).
APP_URL=http://localhost:4000
