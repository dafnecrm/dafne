{
  // Next compiles the workspace packages from their sources: no project
  // references (tsc would read their declarations instead).
  "nx": {
    "sync": {
      "ignoredDependencies": [
        "@dafne/contracts",
        "@dafne/permissions",
        "@dafne/frontend-auth",
        "@dafne/frontend-api",
        "@dafne/frontend-ui",
        "@dafne/frontend-forms",
        "@dafne/frontend-data-table",
        "@dafne/frontend-customers",
        "@dafne/frontend-geo",
        "@dafne/frontend-activities",
        "@dafne/frontend-products",
        "@dafne/frontend-sales-orders",
        "@dafne/frontend-changelog",
        "@dafne/frontend-assistant",
        "@dafne/frontend-user-groups",
        "@dafne/frontend-permissions",
        "@dafne/frontend-users",
        "@dafne/frontend-documents",
        "@dafne/frontend-logger",
        "@dafne/frontend-tasks"
      ]
    }
  },
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
