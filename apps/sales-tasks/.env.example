# apps/sales-tasks: the sales app's scheduled tasks (BullMQ worker) and the
# admins' API for them (/tasks).
PORT=3002

# The Dafne database (the tasks schema, and the sales tables the tasks
# work on). In development, its owner, as in MIGRATIONS_DATABASE_URL.
DATABASE_URL=postgres://dafne:secret@db.dafne.localhost:5432/dafne

# apps/auth: the API asks it for the session of each request's cookie.
AUTH_URL=http://localhost:3001

## Migrations on startup (production)
# true: before starting, apply the pending migrations of every schema
# (bundled in dist/migrations), as `pnpm dafne db migrate` does.
MIGRATE_ON_START=false
# Needed with MIGRATE_ON_START=true: a user that can create and alter the schemas.
MIGRATIONS_DATABASE_URL=

## Tasks (@dafne/backend-tasks)
# The queue's Redis (BullMQ): the redis service of compose.yaml in
# development. Default redis://localhost:6379.
REDIS_URL=redis://redis.dafne.localhost:6379
# Runs (of different tasks) at once, per instance (default 4).
TASKS_CONCURRENCY=4
# Finished runs older than this are deleted by tasks.cleanup (default 30).
TASKS_RETENTION_DAYS=30

## Logs (@dafne/backend-logger, pino)
# trace | debug | info | warn | error | fatal | silent (default debug, info
# with NODE_ENV=production).
LOG_LEVEL=
# true: readable lines; false: JSON (default true, false with NODE_ENV=production).
LOG_PRETTY=
# Also write JSON to this file, rotated (e.g. logs/app.log): LOG_FILE_LEVEL,
# LOG_FILE_FREQUENCY (daily | hourly | milliseconds), LOG_FILE_SIZE (e.g. 10m),
# LOG_FILE_COUNT (files kept, default 7).
LOG_FILE=

## Observability (@dafne/backend-telemetry, OpenTelemetry; docs/observability.md)
# Traces, metrics and logs to Grafana over OTLP: the otel service of
# compose.yaml in development (Grafana at http://otel.dafne.localhost:3200),
# opt-in: uncomment, and run `pnpm dafne dev --telemetry`.
# Empty: no telemetry, logs on the console only. Grafana Cloud: its OTLP
# endpoint, plus
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instanceId:token>.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel.dafne.localhost:4318
