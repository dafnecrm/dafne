import { DatabaseService, schema } from '@app/database';
import { NotFoundException } from '@nestjs/common';
import { Test, TestingModule } from '@nestjs/testing';
import { and, asc, desc, eq, isNull, like } from 'drizzle-orm';
import { <%= s.camel %>BodySchema, type <%= s.pascal %>BodyInput } from '@app/contracts';
import { <%= p.pascal %>Service } from './<%= p.kebab %>.service.js';

/** A body as the validation pipe hands it to the service. */
const body = (input: <%= s.pascal %>BodyInput) => <%= s.camel %>BodySchema.parse(input);

const { <%= s.camel %> } = schema;
const notDeleted = isNull(<%= s.camel %>.deletedAt);

describe('<%= p.pascal %>Service', () => {
  let service: <%= p.pascal %>Service;
  const rows = [{ id: 'r1', name: 'Acme' }];
  // Chainable stand-in for db.select().from().where().orderBy().limit().offset()
  const select = {
    from: vi.fn(),
    where: vi.fn(),
    orderBy: vi.fn(),
    limit: vi.fn(),
    offset: vi.fn(),
  };
  // Stand-ins for insert().values() and update().set().where()
  const insert = { values: vi.fn() };
  const update = { set: vi.fn(), where: vi.fn() };
  const findFirst = vi.fn();
  const db = {
    select: vi.fn(),
    $count: vi.fn(),
    insert: vi.fn(),
    update: vi.fn(),
    delete: vi.fn(),
    query: { <%= s.camel %>: { findFirst } },
  };
  const found = { id: 'r1', name: 'Acme' };

  beforeEach(async () => {
    vi.resetAllMocks();
    db.select.mockReturnValue(select);
    select.from.mockReturnValue(select);
    select.where.mockReturnValue(select);
    select.orderBy.mockReturnValue(select);
    select.limit.mockReturnValue(select);
    select.offset.mockResolvedValue(rows);
    db.$count.mockResolvedValue(42);
    db.insert.mockReturnValue(insert);
    insert.values.mockResolvedValue(undefined);
    db.update.mockReturnValue(update);
    update.set.mockReturnValue(update);
    update.where.mockResolvedValue([{ affectedRows: 1 }]);
    findFirst.mockResolvedValue(found);

    const module: TestingModule = await Test.createTestingModule({
      providers: [
        <%= p.pascal %>Service,
        { provide: DatabaseService, useValue: { db } },
      ],
    }).compile();

    service = module.get(<%= p.pascal %>Service);
  });

  describe('list<%= p.pascal %>', () => {
    it('lists <%= p.lower %> that are not deleted, by name', async () => {
      await expect(service.list<%= p.pascal %>()).resolves.toEqual({
        <%= p.camel %>: rows,
        total: 42,
        limit: 20,
        offset: 0,
      });
      const where = and(notDeleted);
      expect(select.from).toHaveBeenCalledWith(<%= s.camel %>);
      expect(select.where).toHaveBeenCalledWith(where);
      expect(db.$count).toHaveBeenCalledWith(<%= s.camel %>, where);
      expect(select.orderBy).toHaveBeenCalledWith(
        asc(<%= s.camel %>.name),
        asc(<%= s.camel %>.id),
      );
    });

    it('filters with contains, escaping LIKE wildcards', async () => {
      await service.list<%= p.pascal %>({ name: '50%_a' });

      expect(select.where).toHaveBeenCalledWith(
        and(notDeleted, like(<%= s.camel %>.name, '%50\\%\\_a%')),
      );
    });

    it('pages and sorts', async () => {
      await service.list<%= p.pascal %>({
        limit: 5,
        offset: 10,
        sortBy: 'createdAt',
        sortDirection: 'desc',
      });

      expect(select.orderBy).toHaveBeenCalledWith(
        desc(<%= s.camel %>.createdAt),
        asc(<%= s.camel %>.id),
      );
      expect(select.limit).toHaveBeenCalledWith(5);
      expect(select.offset).toHaveBeenCalledWith(10);
    });
  });

  describe('get<%= s.pascal %>', () => {
    it('returns <%= s.a %> that is not deleted, with its users', async () => {
      await expect(service.get<%= s.pascal %>('r1')).resolves.toBe(found);

      const options = findFirst.mock.calls[0][0];
      expect(options.where).toEqual({ id: 'r1', deletedAt: { isNull: true } });
      expect(options.with.createdBy.columns).toEqual({ id: true, name: true });
      expect(options.with.updatedBy.columns).toEqual({ id: true, name: true });
    });

    it('throws 404 when the <%= s.lower %> does not exist or is deleted', async () => {
      findFirst.mockResolvedValue(undefined);

      await expect(service.get<%= s.pascal %>('nope')).rejects.toBeInstanceOf(
        NotFoundException,
      );
    });
  });

  describe('create<%= s.pascal %>', () => {
    it('inserts the <%= s.lower %> with its creator', async () => {
      await expect(
        service.create<%= s.pascal %>(body({ name: 'Acme' }), 'u1'),
      ).resolves.toBe(found);

      const [row] = insert.values.mock.calls[0];
      expect(row).toMatchObject({
        name: 'Acme',
        createdById: 'u1',
        updatedById: 'u1',
      });
      expect(findFirst.mock.calls[0][0].where.id).toBe(row.id);
    });
  });

  describe('update<%= s.pascal %>', () => {
    it('updates the <%= s.lower %>', async () => {
      await service.update<%= s.pascal %>('r1', body({ name: 'Acme Inc' }), 'u2');

      expect(update.set.mock.calls[0][0]).toMatchObject({
        name: 'Acme Inc',
        updatedById: 'u2',
      });
      expect(update.where).toHaveBeenCalledWith(
        and(eq(<%= s.camel %>.id, 'r1'), notDeleted),
      );
    });

    it('throws 404 when the <%= s.lower %> is missing', async () => {
      update.where.mockResolvedValue([{ affectedRows: 0 }]);

      await expect(
        service.update<%= s.pascal %>('nope', body({ name: 'X' }), 'u2'),
      ).rejects.toBeInstanceOf(NotFoundException);
    });
  });

  describe('delete<%= s.pascal %>', () => {
    it('sets deletedAt instead of deleting the row', async () => {
      await service.delete<%= s.pascal %>('r1', 'u3');

      const values = update.set.mock.calls[0][0];
      expect(values.deletedAt).toBeInstanceOf(Date);
      expect(values.updatedById).toBe('u3');
      expect(update.where).toHaveBeenCalledWith(
        and(eq(<%= s.camel %>.id, 'r1'), notDeleted),
      );
      expect(db.delete).not.toHaveBeenCalled();
    });

    it('throws 404 when the <%= s.lower %> is missing or already deleted', async () => {
      update.where.mockResolvedValue([{ affectedRows: 0 }]);

      await expect(service.delete<%= s.pascal %>('r1', 'u3')).rejects.toBeInstanceOf(
        NotFoundException,
      );
    });
  });
});
