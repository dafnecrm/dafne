import { PlusIcon } from "lucide-react";
import type { Metadata } from "next";
import Link from "next/link";
import { Suspense } from "react";
import {
  PageContent,
  PageContentAction,
  PageContentBody,
  PageContentDescription,
  PageContentHeader,
  PageContentTitle,
} from "@/components/page-content";
import { Button } from "@/components/ui/button";
import { Skeleton } from "@/components/ui/skeleton";
import { getTableParams } from "@/lib/data-table";
import { list<%= p.pascal %> } from "@/lib/<%= p.kebab %>";
import { <%= p.camel %>Table } from "@/lib/<%= p.kebab %>-table";
import { requireUser } from "@/lib/session";
import { <%= p.pascal %>Table } from "./<%= p.kebab %>-table";

export const metadata: Metadata = { title: "<%= p.title %>" };

export default function <%= p.pascal %>Page({
  searchParams,
}: PageProps<"/<%= p.kebab %>">) {
  return (
    <PageContent>
      <PageContentHeader>
        <PageContentTitle><%= p.title %></PageContentTitle>
        <PageContentDescription>
          Filter by a field, or click a column to sort.
        </PageContentDescription>
        <PageContentAction>
          <Button nativeButton={false} render={<Link href="/<%= p.kebab %>/new" />}>
            <PlusIcon data-icon="inline-start" />
            New <%= s.lower %>
          </Button>
        </PageContentAction>
      </PageContentHeader>
      <PageContentBody>
        {/* The session and the query are read per request. */}
        <Suspense fallback={<Skeleton className="h-72 w-full" />}>
          <<%= p.pascal %>List searchParams={searchParams} />
        </Suspense>
      </PageContentBody>
    </PageContent>
  );
}

/** Fetches one page; the client table renders it. */
async function <%= p.pascal %>List({
  searchParams,
}: Pick<PageProps<"/<%= p.kebab %>">, "searchParams">) {
  await requireUser();
  const params = getTableParams(await searchParams, <%= p.camel %>Table);
  const data = await list<%= p.pascal %>({
    limit: params.pageSize,
    offset: params.offset,
    filters: params.filters,
    sort: params.sort,
  });

  return (
    <<%= p.pascal %>Table
      <%= p.camel %>={data.<%= p.camel %>}
      total={data.total}
      params={params}
    />
  );
}
