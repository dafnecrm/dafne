"use client";

import Link from "next/link";
import { createDataTableColumnHelper } from "@/components/data-table";
import { LocalDate } from "@/components/local-date";
import type { Listed<%= s.pascal %> } from "@/lib/<%= p.kebab %>";

/*
 * Columns of the <%= p.lower %> table. Column ids double as the backend's
 * sort fields, so they must match <%= p.camel %>Table.sortable in
 * lib/<%= p.kebab %>-table.ts.
 */

const col = createDataTableColumnHelper<Listed<%= s.pascal %>>();

// Module scope, so the table sees the same columns on every render.
export const <%= s.camel %>Columns = col.columns([
  col.accessor("name", {
    header: "Name",
    cell: ({ row }) => (
      <Link
        href={`/<%= p.kebab %>/${encodeURIComponent(row.original.id)}`}
        className="font-medium underline-offset-4 hover:underline"
      >
        {row.original.name}
      </Link>
    ),
  }),
  col.accessor("createdAt", {
    header: "Added",
    meta: { className: "text-right" },
    cell: (info) => (
      <LocalDate value={info.getValue()} className="text-muted-foreground" />
    ),
  }),
]);
