import { ArrowLeftIcon } from "lucide-react";
import type { Metadata } from "next";
import Link from "next/link";
import { Suspense } from "react";
import { BreadcrumbLabel } from "@/components/page-breadcrumb";
import {
  PageContent,
  PageContentAction,
  PageContentBody,
  PageContentHeader,
  PageContentTitle,
} from "@/components/page-content";
import { Button } from "@/components/ui/button";
import { Skeleton } from "@/components/ui/skeleton";
import { <%= s.pascal %>Actions } from "./<%= s.kebab %>-actions";
import { <%= s.pascal %>Details } from "../<%= s.kebab %>-detail";
import { load<%= s.pascal %> } from "./load-<%= s.kebab %>";

export const metadata: Metadata = { title: "<%= s.title %>" };

export default function <%= s.pascal %>Page({ params }: PageProps<"/<%= p.kebab %>/[id]">) {
  return (
    <Suspense fallback={<Skeleton className="h-96 w-full" />}>
      <<%= s.pascal %>Profile params={params} />
    </Suspense>
  );
}

/** Loads the <%= s.lower %>: its name and actions, then its details. */
async function <%= s.pascal %>Profile({
  params,
}: Pick<PageProps<"/<%= p.kebab %>/[id]">, "params">) {
  const <%= s.camel %> = await load<%= s.pascal %>((await params).id);

  return (
    <PageContent>
      <BreadcrumbLabel
        href={`/<%= p.kebab %>/${encodeURIComponent(<%= s.camel %>.id)}`}
        label={<%= s.camel %>.name}
      />
      <PageContentHeader>
        <PageContentTitle>{<%= s.camel %>.name}</PageContentTitle>
        <PageContentAction className="flex flex-wrap justify-end gap-2">
          <Button
            variant="outline"
            size="sm"
            nativeButton={false}
            render={<Link href="/<%= p.kebab %>" />}
          >
            <ArrowLeftIcon data-icon="inline-start" />
            All <%= p.lower %>
          </Button>
          <<%= s.pascal %>Actions <%= s.camel %>={<%= s.camel %>} />
        </PageContentAction>
      </PageContentHeader>
      <PageContentBody>
        <<%= s.pascal %>Details <%= s.camel %>={<%= s.camel %>} />
      </PageContentBody>
    </PageContent>
  );
}
