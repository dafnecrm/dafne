"use client";

import { <%= icon %> } from "lucide-react";
import Link from "next/link";
import { createDataTableColumnHelper, DataTable } from "@/components/data-table";
import { LocalDate } from "@/components/local-date";
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/ui/empty";
import { describeFilters, type TableParams } from "@/lib/data-table";
import type { Listed<%= s.pascal %> } from "@/lib/<%= p.kebab %>";
import { <%= p.camel %>Table } from "@/lib/<%= p.kebab %>-table";
import { <%= s.pascal %>Actions } from "./[id]/<%= s.kebab %>-actions";

/*
 * Columns of the <%= p.lower %> table. Column ids double as the backend's
 * sort fields, so they must match <%= p.camel %>Table.sortable in
 * lib/<%= p.kebab %>-table.ts.
 */

const col = createDataTableColumnHelper<Listed<%= s.pascal %>>();

// Module scope, so the table sees the same columns on every render.
const <%= s.camel %>Columns = col.columns([
  col.accessor("name", {
    header: "Name",
    cell: ({ row }) => (
      <Link
        href={`/<%= p.kebab %>/${encodeURIComponent(row.original.id)}`}
        className="font-medium underline-offset-4 hover:underline"
      >
        {row.original.name}
      </Link>
    ),
  }),
  col.accessor("createdAt", {
    header: "Added",
    meta: { className: "text-right" },
    cell: (info) => (
      <LocalDate value={info.getValue()} className="text-muted-foreground" />
    ),
  }),
]);

// Module scope, so the table sees the same function on every render.
const <%= s.camel %>Actions = (<%= s.camel %>: Listed<%= s.pascal %>) => (
  <<%= s.pascal %>Actions <%= s.camel %>={<%= s.camel %>} placement="table" />
);

const getRowId = (<%= s.camel %>: Listed<%= s.pascal %>) => <%= s.camel %>.id;

/** <%= p.title %> list; the server page passes one page of <%= p.lower %>. */
export function <%= p.pascal %>Table({
  <%= p.camel %>,
  total,
  params,
}: {
  <%= p.camel %>: Listed<%= s.pascal %>[];
  total: number;
  params: TableParams;
}) {
  return (
    <DataTable
      columns={<%= s.camel %>Columns}
      data={<%= p.camel %>}
      getRowId={getRowId}
      config={<%= p.camel %>Table}
      rowActions={<%= s.camel %>Actions}
      params={params}
      total={total}
      noun="<%= p.lower %>"
      empty={
        <Empty>
          <EmptyHeader>
            <EmptyMedia variant="icon">
              <<%= icon %> />
            </EmptyMedia>
            <EmptyTitle>No <%= p.lower %> found</EmptyTitle>
            <EmptyDescription>
              {Object.keys(params.filters).length
                ? `No <%= s.lower %> where ${describeFilters(params.filters, <%= p.camel %>Table.filters)}.`
                : "Add your first <%= s.lower %> to get started."}
            </EmptyDescription>
          </EmptyHeader>
        </Empty>
      }
    />
  );
}
