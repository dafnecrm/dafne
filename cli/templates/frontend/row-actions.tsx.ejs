"use client";

import { EllipsisVerticalIcon, EyeIcon, PencilIcon } from "lucide-react";
import Link from "next/link";
import { Button } from "@/components/ui/button";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";
import type { Listed<%= s.pascal %> } from "@/lib/<%= p.kebab %>";
import { Delete<%= s.pascal %>Button } from "./delete-<%= s.kebab %>-button";

/** Row actions of the <%= p.lower %> table (DataTable `rowActions`). */
export function <%= s.camel %>Actions(<%= s.camel %>: Listed<%= s.pascal %>) {
  const href = `/<%= p.kebab %>/${encodeURIComponent(<%= s.camel %>.id)}`;
  return (
    <>
      <Delete<%= s.pascal %>Button <%= s.camel %>={<%= s.camel %>} then="refresh" iconOnly />
      <DropdownMenu>
        <DropdownMenuTrigger
          render={
            <Button
              variant="ghost"
              size="icon-sm"
              aria-label={`Actions for ${<%= s.camel %>.name}`}
            />
          }
        >
          <EllipsisVerticalIcon />
        </DropdownMenuTrigger>
        <DropdownMenuContent align="end">
          <DropdownMenuItem render={<Link href={href} />}>
            <EyeIcon />
            View details
          </DropdownMenuItem>
          <DropdownMenuItem render={<Link href={`${href}/edit`} />}>
            <PencilIcon />
            Edit
          </DropdownMenuItem>
        </DropdownMenuContent>
      </DropdownMenu>
    </>
  );
}
