"use client";

import { DropdownMenuSeparator } from "@/components/ui/dropdown-menu";
import {
  <%= s.pascal %>ActionsMenu,
  use<%= s.pascal %>Actions,
  type <%= s.pascal %>Ref,
} from "./<%= s.kebab %>-actions";

/** Actions of a row of the <%= p.lower %> table, in a menu. */
export function <%= s.pascal %>TableActions({ <%= s.camel %> }: { <%= s.camel %>: <%= s.pascal %>Ref }) {
  const { items, dialogs } = use<%= s.pascal %>Actions(<%= s.camel %>, { placement: "table" });

  return (
    <<%= s.pascal %>ActionsMenu <%= s.camel %>={<%= s.camel %>} variant="ghost" dialogs={dialogs}>
      {items.view}
      {items.edit}
      <DropdownMenuSeparator />
      {items.delete}
    </<%= s.pascal %>ActionsMenu>
  );
}
