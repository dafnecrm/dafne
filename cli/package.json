{
  "name": "@dafne/cli",
  "version": "0.1.0",
  "description": "Generates Dafne backend and frontend resources",
  "private": true,
  "type": "module",
  "bin": {
    "dafne": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "ejs": "^7.0.2",
    "jsonc-parser": "^3.3.1",
    "pluralize": "^8.0.0",
    "prettier": "^3.9.10",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.6",
    "@types/pluralize": "^0.0.33",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
